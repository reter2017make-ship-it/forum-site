<% const sz = typeof size !== 'undefined' ? size : 's'; const lk = typeof link === 'undefined' ? true : link; const nm = u ? u.username : (typeof name !== 'undefined' ? name : '?'); %><<%= lk && u ? 'a' : 'span' %> <% if (lk && u) { %>href="/members/<%= encodeURIComponent(nm) %>/"<% } %> class="avatar avatar--<%= sz %>" style="background:<%= fmt.avatarColor(nm) %>"><% if (u && u.avatar) { %><img src="/data/avatars/<%= u.avatar %>" alt="<%= nm %>" loading="lazy"><% } else { %><%= String(nm).charAt(0).toUpperCase() %><% } %></<%= lk && u ? 'a' : 'span' %>>
