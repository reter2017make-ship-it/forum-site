<%- include('top') %>
<div class="block"><div class="block-container">
  <% rows.forEach(function (m) { %>
    <div class="block-row"><div style="display:flex;justify-content:space-between;gap:8px"><b><%= m.name %> <span class="u-dim">&lt;<%= m.email %>&gt;</span> <%= m.is_read ? '' : '🆕' %></b><span class="u-small u-muted"><%= fmt.ago(m.created_at) %></span></div>
      <div style="white-space:pre-wrap;margin:6px 0"><%= m.message %></div>
      <form method="post" action="/admin/messages/<%= m.id %>/delete" data-confirm="Удалить?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button button--small button--link" style="color:var(--danger)">Удалить</button></form></div>
  <% }) %>
  <% if (!rows.length) { %><div class="block-empty">Сообщений нет.</div><% } %>
</div></div>
<%- include('bottom') %>
